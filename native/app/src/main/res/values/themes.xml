<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SNScanner" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent_dark</item>
        <item name="colorSecondary">@color/ink</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_soft</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.SNScanner.Dialog</item>
    </style>

    <style name="Theme.SNScanner.Scanner" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/scan_bg</item>
        <item name="android:statusBarColor">@color/scan_bg</item>
        <item name="android:navigationBarColor">@color/scan_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/scan_bg</item>
        <item name="colorOnSurface">@color/white</item>
    </style>

    <style name="ThemeOverlay.SNScanner.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
    </style>

    <style name="TextAppearance.SNScanner.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.SNScanner.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.SNScanner.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Widget.SNScanner.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
